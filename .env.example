# GEC Tirunelveli - ELYX'26 / ARTIFEX'25 Cultural Events Registration Platform
# Supabase Configuration
# Get these credentials from your Supabase Project Settings -> API
# https://supabase.com/dashboard/project/_/settings/api

# Modern Supabase Publishable Key and Project URL (Prefixed with VITE_ for Vite frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key-here

# Legacy Anon Key (Supported for backward compatibility)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Security Notice:
# NEVER expose SUPABASE_SERVICE_ROLE_KEY or database passwords in this file or any client code.
